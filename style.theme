#+HTML_HEAD: /* --- Tufte-style sidenotes & margin notes ----------------------------- */
#+HTML_HEAD: body { counter-reset: sidenote-counter; }
#+HTML_HEAD: .sidenote, .marginnote {
#+HTML_HEAD:     float: right;
